PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://carepaddy:carepaddy_local_dev@localhost:5432/carepaddy
REDIS_URL=redis://127.0.0.1:6379
# Local default is in-memory. For Redis OTP/rate-limits locally:
#   docker compose up -d redis
#   KV_STORE=redis
KV_STORE=memory
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
# Customer / care-home / guardian app (invite + password-reset links)
# Staging: https://care-zc81.vercel.app
# Production: https://carepaddy.co.uk
CLIENT_PUBLIC_URL=http://localhost:3000
# Legacy alias for CLIENT_PUBLIC_URL — used only if CLIENT_PUBLIC_URL is unset
# APP_PUBLIC_URL=http://localhost:3000

# Platform admin app (admin invite + password-reset links)
# Staging: https://carepaddy-admin.vercel.app
# Production: https://admin.carepaddy.co.uk
ADMIN_PUBLIC_URL=http://localhost:3001

AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@carepaddy.com
SNS_SENDER_ID=CarePaddy
# Contact address shown to care homes in deactivation / email-change notices
# SUPPORT_EMAIL=support@carepaddy.co.uk

OTP_CODE_TTL_SECONDS=300
OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_SECONDS=600

# UK address autocomplete (required for GET /client/postcode)
# https://getaddress.io/
GETADDRESS_API_KEY=

# Public API URL used when building profile image URLs (local uploads/)
# API_PUBLIC_URL=https://dev-api.carepaddy.co.uk

# Force SUPER_ADMIN to enroll MFA before using the back office (default false)
# ADMIN_REQUIRE_SUPER_ADMIN_MFA=true

# Platform admin back office seed (pnpm prisma:seed)
# ADMIN_SEED_EMAIL=superadmin@carepaddy.co.uk
# ADMIN_SEED_PASSWORD=change-me-12-chars-min

